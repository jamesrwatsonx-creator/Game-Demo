{
  "name": "head-on-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-thumb competitive head-on endless runner — mobile-first 3D prototype (TypeScript + Three.js).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
